rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
        || (signedIn() && resource.data.isPublic == true);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'displayName', 'email', 'isPublic', 'trialStartedAt', 'createdAt'
        ])
        && request.resource.data.isPublic is bool
        && request.resource.data.trialStartedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.premiumUntil == null;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'isPublic', 'reminderHour']);
      allow delete: if isOwner(userId);

      match /following/{followedUserId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && followedUserId != userId
          && get(/databases/$(database)/documents/users/$(followedUserId)).data.isPublic == true;
        allow delete: if isOwner(userId) || followedUserId == request.auth.uid;
      }

      match /followers/{followerId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(followerId)
          && followerId != userId
          && get(/databases/$(database)/documents/users/$(userId)).data.isPublic == true;
        allow delete: if isOwner(followerId);
      }
    }

    match /photos/{photoId} {
      // The client checks whether today's document already exists before
      // choosing update or create. A missing document contains no private
      // data, so let that single-document check succeed for signed-in users.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/photos/$(photoId))
          || resource.data.isPublic == true
          || resource.data.ownerId == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && photoId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasAll([
          'ownerId', 'imageUrl', 'storagePath', 'capturedAt', 'isPublic',
          'likeCount', 'likedBy'
        ])
        && request.resource.data.imageUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.capturedAt is timestamp
        && request.resource.data.capturedAt <= request.time
        && request.resource.data.isPublic is bool
        && request.resource.data.isPublic == get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.isPublic
        && request.resource.data.likeCount == 0
        && request.resource.data.likedBy is list
        && request.resource.data.likedBy.size() == 0;
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerName', 'ownerAvatarUrl', 'imageUrl', 'storagePath',
            'capturedAt', 'dayKey', 'isPublic'
          ])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.likeCount == resource.data.likeCount
          && request.resource.data.likedBy == resource.data.likedBy
          && request.resource.data.isPublic == get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.isPublic)
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likeCount'])
          && request.resource.data.likeCount == request.resource.data.likedBy.size()
          && (
            (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
              && request.resource.data.likedBy.hasAll(resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && !(request.auth.uid in resource.data.likedBy))
            ||
            (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
              && resource.data.likedBy.hasAll(request.resource.data.likedBy)
              && request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy))
          )
        )
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
